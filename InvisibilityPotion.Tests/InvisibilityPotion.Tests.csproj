<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>10</LangVersion>
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pure logic is compiled straight into the test assembly; the game project cannot be referenced from net8.0 -->
    <Compile Include="../InvisibilityPotion/PatchHealth.Core.cs" Link="PatchHealth.Core.cs" />
    <!-- Wrapped in #if DEBUG; DEBUG is defined above so this compiles in any configuration -->
    <Compile Include="../InvisibilityPotion/Dev/AutoJoinConfig.Core.cs" Link="AutoJoinConfig.Core.cs" />
    <Compile Include="../InvisibilityPotion/Config/TierConfig.Core.cs" Link="TierConfig.Core.cs" />
    <Compile Include="../InvisibilityPotion/Effects/InvisibilityStateMachine.Core.cs" Link="InvisibilityStateMachine.Core.cs" />
    <Compile Include="../InvisibilityPotion/Visuals/FogSettings.Core.cs" Link="FogSettings.Core.cs" />
    <Compile Include="../InvisibilityPotion/Items/PotionVfx.Core.cs" Link="PotionVfx.Core.cs" />
  </ItemGroup>
</Project>
